{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mike-Aniki/AnikiCommunityPacks/catalog.schema.json",
  "title": "Aniki Community Packs Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "packs"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "const": 1
    },
    "packs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pack"
      }
    }
  },
  "$defs": {
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "name",
        "author",
        "version",
        "description",
        "previewUrl",
        "downloadUrl",
        "publishedAt",
        "updatedAt"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "visual",
            "color",
            "login",
            "sound",
            "complete"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "author": {
          "type": "string",
          "maxLength": 120
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9-]+$"
        },
        "componentIds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "visual": {
              "type": "string",
              "minLength": 3,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "login": {
              "type": "string",
              "minLength": 3,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "sound": {
              "type": "string",
              "minLength": 3,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "color": {
              "type": "string",
              "minLength": 3,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          }
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "description": {
          "type": "string",
          "maxLength": 160
        },
        "previewUrl": {
          "type": "string",
          "format": "uri"
        },
        "downloadUrl": {
          "type": "string",
          "format": "uri"
        },
        "publishedAt": {
          "type": "string",
          "format": "date"
        },
        "updatedAt": {
          "type": "string",
          "format": "date"
        },
        "featured": {
          "type": "boolean",
          "default": false
        },
        "packPreviews": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "visual": {
              "type": "string",
              "format": "uri"
            },
            "color": {
              "type": "string",
              "format": "uri"
            },
            "login": {
              "type": "string",
              "format": "uri"
            },
            "sound": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    }
  }
}
